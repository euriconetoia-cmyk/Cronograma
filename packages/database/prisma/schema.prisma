generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum ModalityStatus {
  ACTIVE
  INACTIVE
}

enum CalendarEventType {
  NATIONAL_HOLIDAY
  STATE_HOLIDAY
  MUNICIPAL_HOLIDAY
  RECESS
  VACATION
  ACADEMIC_DAY
  NON_ACADEMIC_DAY
  BLOCKED_DATE
  INSTITUTIONAL_EVENT
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum ClassGroupStatus {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ClassGroupPersonRole {
  INSTRUCTOR
  TUTOR
  MONITOR
  PLANNER
}

enum ScheduleStatus {
  GENERATED
  REVIEW
  APPROVED
  PUBLISHED
}

enum ScheduleItemType {
  CURRICULAR_UNIT
  RECOVERY
  ENROLLMENT
  INAUGURAL_CLASS
}

enum MeetingType {
  PRESENTIAL
  WEB_CLASS
  PRACTICE
  LAB
  ASSESSMENT
  RECOVERY
  INAUGURAL_CLASS
  OTHER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id        String             @id @default(cuid())
  name      String
  code      String             @unique
  city      String
  state     String
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  courses   Course[]
  calendars AcademicCalendar[]
  classGroups ClassGroup[]
}

model Modality {
  id                       String         @id @default(cuid())
  name                     String         @unique
  code                     String         @unique
  description              String?
  status                   ModalityStatus @default(ACTIVE)
  allowsEad                Boolean        @default(false)
  allowsSynchronous        Boolean        @default(false)
  allowsInPersonMeetings   Boolean        @default(true)
  allowsWebClasses         Boolean        @default(false)
  defaultDailyHours        Int?
  defaultAvaExtraDays      Int            @default(0)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  courses                  Course[]
  classGroups              ClassGroup[]
}

model Course {
  id                String          @id @default(cuid())
  name              String
  code              String          @unique
  description       String?
  totalHours        Int
  status            CourseStatus    @default(ACTIVE)
  responsibleUnitId String?
  defaultModalityId String?
  responsibleUnit   Unit?           @relation(fields: [responsibleUnitId], references: [id])
  defaultModality   Modality?       @relation(fields: [defaultModalityId], references: [id])
  versions          CourseVersion[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  classGroups       ClassGroup[]
}

model CourseVersion {
  id          String         @id @default(cuid())
  name        String
  description String?
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  active      Boolean        @default(true)
  modules     CourseModule[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([courseId, name])
}

model CourseModule {
  id              String           @id @default(cuid())
  name            String
  code            String?
  order           Int
  courseVersionId String
  courseVersion   CourseVersion    @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  curricularUnits CurricularUnit[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([courseVersionId, order])
}

model CurricularUnit {
  id                    String       @id @default(cuid())
  name                  String
  code                  String?
  order                 Int
  totalHours            Int
  inPersonHours         Int          @default(0)
  eadHours              Int          @default(0)
  synchronousHours      Int          @default(0)
  asynchronousHours     Int          @default(0)
  suggestedStudyDays    Int?
  meetingCount          Int          @default(0)
  meetingHours          Int?
  requiresWebClass      Boolean      @default(false)
  requiresInPerson      Boolean      @default(false)
  recoveryEnabled       Boolean      @default(false)
  enrollmentPeriodDays  Int?
  inauguralClass        Boolean      @default(false)
  avaExtraDays          Int          @default(0)
  observations          String?
  moduleId              String
  module                CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  scheduleItems         ScheduleItem[]

  @@unique([moduleId, order])
}


model AcademicCalendar {
  id        String          @id @default(cuid())
  name      String
  year      Int
  unitId    String
  unit      Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  active    Boolean         @default(true)
  events    CalendarEvent[]
  classGroups ClassGroup[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([unitId, year])
}

model CalendarEvent {
  id                       String            @id @default(cuid())
  calendarId               String
  calendar                 AcademicCalendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  type                     CalendarEventType
  title                    String
  startDate                DateTime
  endDate                  DateTime
  blocksAcademicActivities Boolean           @default(true)
  description              String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([calendarId, startDate, endDate])
}


model Person {
  id        String             @id @default(cuid())
  name      String
  email     String?
  registry  String?
  active    Boolean            @default(true)
  classLinks ClassGroupPerson[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model ClassGroup {
  id                         String                  @id @default(cuid())
  code                       String                  @unique
  expectedStudents           Int?
  startDate                  DateTime
  endDateLimit               DateTime?
  status                     ClassGroupStatus        @default(DRAFT)
  courseId                   String
  courseVersionId            String
  unitId                     String
  modalityId                 String
  academicCalendarId         String
  generateRecovery           Boolean                 @default(false)
  createEnrollmentPeriod     Boolean                 @default(false)
  createInauguralClass       Boolean                 @default(false)
  avaExtraDays               Int                     @default(0)
  allowSaturday              Boolean                 @default(false)
  allowSunday                Boolean                 @default(false)
  allowOverlap               Boolean                 @default(false)
  allowNextUcDuringRecovery  Boolean                 @default(false)
  observations               String?
  course                     Course                  @relation(fields: [courseId], references: [id])
  courseVersion              CourseVersion           @relation(fields: [courseVersionId], references: [id])
  unit                       Unit                    @relation(fields: [unitId], references: [id])
  modality                   Modality                @relation(fields: [modalityId], references: [id])
  academicCalendar           AcademicCalendar        @relation(fields: [academicCalendarId], references: [id])
  scheduleRules              ClassScheduleRule[]
  people                     ClassGroupPerson[]
  schedule                   Schedule?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
}

model ClassScheduleRule {
  id              String     @id @default(cuid())
  classGroupId    String
  classGroup      ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  weekday         Weekday
  startTime       String
  endTime         String
  maxDailyHours   Int?
  enabled         Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([classGroupId, weekday])
}

model ClassGroupPerson {
  id           String               @id @default(cuid())
  classGroupId String
  personId     String
  role         ClassGroupPersonRole
  classGroup   ClassGroup           @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  person       Person               @relation(fields: [personId], references: [id])
  createdAt    DateTime             @default(now())

  @@unique([classGroupId, personId, role])
}


model Schedule {
  id           String          @id @default(cuid())
  classGroupId String          @unique
  classGroup   ClassGroup      @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  status       ScheduleStatus  @default(GENERATED)
  generatedAt  DateTime        @default(now())
  startDate    DateTime?
  endDate      DateTime?
  items        ScheduleItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ScheduleItem {
  id               String           @id @default(cuid())
  scheduleId       String
  schedule         Schedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  curricularUnitId String?
  curricularUnit   CurricularUnit?  @relation(fields: [curricularUnitId], references: [id])
  type             ScheduleItemType
  title            String
  order            Int
  startDate        DateTime
  endDate          DateTime
  avaEndDate       DateTime?
  totalHours       Int              @default(0)
  notes            String?
  meetings         Meeting[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([scheduleId, order])
}

model Meeting {
  id             String        @id @default(cuid())
  scheduleItemId String
  scheduleItem   ScheduleItem  @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  number         Int
  type           MeetingType
  date           DateTime
  startTime      String
  endTime        String
  hours          Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([scheduleItemId, number])
}
