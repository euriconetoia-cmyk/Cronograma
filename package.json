{
  "name": "cronograma",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" build && pnpm --parallel --filter @cronograma/web --filter @cronograma/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @cronograma/database prisma generate",
    "db:migrate": "pnpm --filter @cronograma/database prisma migrate dev",
    "db:studio": "pnpm --filter @cronograma/database prisma studio",
    "db:deploy": "pnpm --filter @cronograma/database prisma migrate deploy",
    "dados:exemplo": "node scripts/dados-exemplo.mjs",
    "pretypecheck": "pnpm --filter \"./packages/**\" build",
    "pretest": "pnpm --filter \"./packages/**\" build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "10.34.6"
  }
}
